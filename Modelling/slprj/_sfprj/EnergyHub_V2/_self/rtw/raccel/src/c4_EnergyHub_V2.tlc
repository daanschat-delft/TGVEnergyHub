%implements "chartSource" "C"
%function ChartConfig(block, system) void
  %createrecord chartConfiguration { ...
          executeAtInitialization  0 ...
  }
  %return chartConfiguration
%endfunction
%function ChartDataMap(block, system) void
  %createrecord ChartDataElements {\
    NumChartData   8 \
    ChartDataDefaults {\
      RecordType   "ChartData"\
      Dimensions   []\
      IsTestPoint  0\
    }\
    ChartData {\
      Name         "sfEvent"\
      Description  "ActiveChartEvent"\
      SFName       ""\
      Path         ""\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "doneDoubleBufferReInit"\
      Description  "DoubleBufferInitCheck"\
      SFName       ""\
      Path         ""\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "startTime"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:241:568-577"\
    }\
    ChartData {\
      Name         "startTime_not_empty"\
      Description  "EmlPersistentSentinel"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:241:568-577"\
    }\
    ChartData {\
      Name         "stopTime"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:241:578-586"\
    }\
    ChartData {\
      Name         "stopTime_not_empty"\
      Description  "EmlPersistentSentinel"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:241:578-586"\
    }\
    ChartData {\
      Name         "isRampActive"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:241:587-599"\
    }\
    ChartData {\
      Name         "isRampActive_not_empty"\
      Description  "EmlPersistentSentinel"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:241:587-599"\
    }\
  }
  %return ChartDataElements
%endfunction
