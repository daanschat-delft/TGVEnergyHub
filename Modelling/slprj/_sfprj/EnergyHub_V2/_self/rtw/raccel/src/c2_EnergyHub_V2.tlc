%implements "chartSource" "C"
%function ChartConfig(block, system) void
  %createrecord chartConfiguration { ...
          executeAtInitialization  0 ...
  }
  %return chartConfiguration
%endfunction
%function ChartDataMap(block, system) void
  %createrecord ChartDataElements {\
    NumChartData   10 \
    ChartDataDefaults {\
      RecordType   "ChartData"\
      Dimensions   []\
      IsTestPoint  0\
    }\
    ChartData {\
      Name         "sfEvent"\
      Description  "ActiveChartEvent"\
      SFName       ""\
      Path         ""\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "doneDoubleBufferReInit"\
      Description  "DoubleBufferInitCheck"\
      SFName       ""\
      Path         ""\
      SrcLocation  ""\
    }\
    ChartData {\
      Name         "hasRunToday"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:222:870-881"\
    }\
    ChartData {\
      Name         "hasRunToday_not_empty"\
      Description  "EmlPersistentSentinel"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:222:870-881"\
    }\
    ChartData {\
      Name         "Remain"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:222:947-953"\
    }\
    ChartData {\
      Name         "Remain_not_empty"\
      Description  "EmlPersistentSentinel"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:222:947-953"\
    }\
    ChartData {\
      Name         "lastDay"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:222:970-977"\
    }\
    ChartData {\
      Name         "lastDay_not_empty"\
      Description  "EmlPersistentSentinel"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:222:970-977"\
    }\
    ChartData {\
      Name         "firstSimulatedDay"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:222:1041-1058"\
    }\
    ChartData {\
      Name         "firstSimulatedDay_not_empty"\
      Description  "EmlPersistentSentinel"\
      SFName       ""\
      Path         ""\
      SrcLocation  "EnergyHub_V2:222:1041-1058"\
    }\
  }
  %return ChartDataElements
%endfunction
